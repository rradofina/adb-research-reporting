# Supabase — ADB Research
# Project ref: pyswpjntydkmqtdldvmo
# Region: (set when you check the project; record in versions.json)
#
# The anon key is safe to use client-side. The service-role key is NOT.
# The DB password is for direct Postgres connections (psql, scripts).
#
# Get values from:
#   Project URL + anon key:  Settings → API → Project URL / Project API keys
#   Service-role key:         Settings → API → service_role (⚠️ secret)
#   DB password:              Settings → Database → Connection string

SUPABASE_URL=https://pyswpjntydkmqtdldvmo.supabase.co
SUPABASE_ANON_KEY=<paste-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<paste-service-role-key>
SUPABASE_DB_HOST=db.pyswpjntydkmqtdldvmo.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=<paste-fresh-password-after-rotation>

# Optional: pooler connection (recommended for serverless / many concurrent calls)
SUPABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_POOLER_PORT=6543

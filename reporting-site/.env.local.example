# Reporting site env vars.
#
# Copy to .env.local for local dev (gitignored).
# On Vercel: Settings → Environment Variables.
#
# Both are safe to expose to browsers (anon key has read-only access
# to public.* views, scoped by Supabase RLS). The service-role key and
# DB password do NOT belong here — only the upstream sync pipeline uses
# those, and they live in the parent project's .env.local outside this
# repo.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
